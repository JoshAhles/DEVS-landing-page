---
import WorkspaceMockup from "./WorkspaceMockup.astro";
const steps = [
  ["plan", "pick up a ticket", "copy-muted"],
  ["branch", "build it in small commits", "copy-muted"],
  ["pr", "open the pull request", "text-[var(--color-accent)]"],
  ["review", "respond to teammates", "text-[var(--color-warn)]"],
  ["merge", "ship it, then retro", "text-[var(--color-merge)]"],
];
---
<p class="eyebrow">how it works</p>
<h2 class="section-title mt-5">One loop. Every ticket. Until it's reflex.</h2>
<p class="section-lede">The exact cycle a real team runs. Tickets get harder; the loop never changes.</p>
<ol class="mt-10 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-sm" data-reveal>
  {steps.map(([k, d, cls], i) => (
    <>
      <li class="flex items-baseline gap-2">
        <span class:list={["font-medium", cls]}>{k}</span>
        <span class="copy-subtle text-xs">{d}</span>
      </li>
      {i < steps.length - 1 && <li aria-hidden="true" class="copy-subtle">→</li>}
    </>
  ))}
</ol>
<div class="mt-10 elev rounded-xl" data-reveal>
  <WorkspaceMockup />
  <p class="mt-3 text-center font-mono text-xs copy-subtle">Early concept of the DEVS workspace. Founding members shape what ships.</p>
</div>
