---
interface Props { id: string; class?: string; wide?: boolean }
const { id, class: cls = "", wide = false } = Astro.props;
---
<section id={id} class:list={["section relative", cls]}>
  <div class:list={["section-inner relative", wide && "max-w-[80rem]"]} data-animate>
    <slot />
  </div>
</section>
