---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "DEVS is a simulated engineering team where developers practice pull requests, code review, and sprints before their first job. Free during early access.",
} = Astro.props;
import "../styles/global.css";
import Header from "../components/Header.astro";
import Analytics from "../components/Analytics.astro";
import ConsentToast from "../components/ConsentToast.astro";
import { FAQ } from "../data/faq.js";

const siteUrl = "https://begindevs.com";
const ogImage = `${siteUrl}/og-image.png`;
const currentUrl = new URL(Astro.url.pathname, siteUrl).toString();
const isHomePage = Astro.url.pathname === "/";

const organizationJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "DEVS",
  url: siteUrl,
  logo: `${siteUrl}/images/DEVS-logo-transparent.png`,
  founder: { "@type": "Person", name: "Josh Ahles", url: "https://joshahles.com/" },
  sameAs: [
    "https://github.com/JoshAhles",
    "https://www.linkedin.com/in/joshahles/",
    "https://x.com/begindevs",
  ],
});

const webSiteJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "DEVS",
  url: siteUrl,
  description,
});

const webPageJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  url: currentUrl,
  description,
  isPartOf: { "@type": "WebSite", url: siteUrl, name: "DEVS" },
});

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
});
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0C10" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={currentUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="DEVS blog" href="/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DEVS" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="DEVS: you can write code, now ship it with a team" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@begindevs" />
    <meta name="twitter:creator" content="@begindevs" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="DEVS: you can write code, now ship it with a team" />

    <script type="application/ld+json" set:html={organizationJsonLd} />
    <script type="application/ld+json" set:html={webSiteJsonLd} />
    <script type="application/ld+json" set:html={webPageJsonLd} />
    {isHomePage && <script type="application/ld+json" set:html={faqJsonLd} />}

    <Analytics />
    <title>{title}</title>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-[var(--color-accent)] focus:px-4 focus:py-2 focus:text-[var(--color-accent-ink)]"
      >Skip to content</a
    >
    <Header />
    <slot />
    {isHomePage && (
      <script>
        import "../scripts/animations.js";
      </script>
    )}
    <ConsentToast />
  </body>
</html>
